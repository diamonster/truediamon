u/</guid><description>&lt;p&gt;Всё просто:&lt;/p&gt;&#10;&lt;div class="highlight-wrapper"&gt;&#10; &lt;div class="highlight-toolbar"&gt;&#10; &#10; &lt;span class="highlight-lang"&gt;bash&lt;/span&gt;&#10; &#10; &lt;button type="button" class="highlight-copy" data-copied="Скопировано"&gt;Копировать&lt;/button&gt;&#10; &lt;/div&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-bash" data-lang="bash"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;sudo update-alternatives --config x-www-browser&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&#10;&lt;/div&gt;</description></item></channel></rss>